diff --git a/syscall/sleepProcesses.c b/syscall/sleepProcesses.c
new file mode 100644
--- a/syscall/sleepProcesses.c
+++ b/syscall/sleepProcesses.c
@@ -0,0 +1,51 @@
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/sched.h>
+#include <linux/syscalls.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+asmlinkage long sys_listSleepProcesses(char __user *buf, int size) {
+	struct task_struct *proces;
+	char *kbuf;
+	int offset = 0;
+	int ret;
+
+	if (!buf || size <= 0)
+		return -EINVAL;
+
+	kbuf = kmalloc(size, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	kbuf[0] = '\0';
+
+	for_each_process(proces) {
+		long state = (long)proces->state;
+		const char *state_str = NULL;
+
+		if (state == TASK_INTERRUPTIBLE) {
+			state_str = "INTERRUPTIBLE (sleep)";
+		} else if (state == TASK_UNINTERRUPTIBLE) {
+			state_str = "UNINTERRUPTIBLE (sleep)";
+		}
+
+		if (state_str) {
+			int written = snprintf(kbuf + offset, size - offset,
+					       "PID: %ld | State: %s | Name: %s\n",
+					       (long)task_pid_nr(proces), state_str, proces->comm);
+			if (written >= size - offset) {
+				break;
+			}
+			offset += written;
+		}
+	}
+
+	ret = copy_to_user(buf, kbuf, offset + 1);
+	kfree(kbuf);
+
+	if (ret != 0)
+		return -EFAULT;
+
+	return offset;
+}
